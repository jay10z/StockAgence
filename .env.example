# Copy to .env and fill with your Supabase project keys
# Dashboard → Project Settings → API
#
# Frontend (safe for browser / Vercel env):
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Serverless API on Vercel (same URL + anon, plus service role — server only):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret

# Optional local API port (scripts/local-api.mjs only)
# API_PORT=3001
